# Rendered at start by the image's envsubst entrypoint into /tmp/site.conf.
# Only defined environment variables are substituted; here that is
# HUB_UPSTREAM: the hub's base URL, scheme://host[:port] with no path and no
# trailing slash (https://clankmail.zacx.dev, or an in-cluster address).

# A short cache in front of the hub: every page view asks for the same list,
# and the hub rate-limits per client address, which is this proxy's.
proxy_cache_path /tmp/hubcache levels=1 keys_zone=hubcache:1m max_size=8m inactive=2m use_temp_path=off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Nothing here takes a request body.
    client_max_body_size 1k;
    client_body_timeout 5s;
    client_header_timeout 5s;
    send_timeout 10s;

    # Every response, errors included. No add_header appears in any location
    # below, so these are never dropped by nginx's add_header inheritance.
    # The two hashes are the page's one inline <style> and one inline
    # <script>; site/test.sh fails if they no longer match site/index.html.
    add_header Content-Security-Policy "default-src 'self'; script-src 'sha256-dlG4xEIO5IJaw4N0BqimrZBcW9TowAuqXetjsyseNFs='; style-src 'sha256-tmRLOEhUEV0C2ETHuclGyd2ggHPwPUaaLGJke1eUpMc='; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The only proxied path: GET /api/channels -> $HUB_UPSTREAM/v1/channels,
    # with the query string. proxy_pass has a fixed URI, so the client can
    # choose the query string but never the upstream path.
    location = /api/channels {
        if ($request_method != GET) {
            return 405;
        }
        proxy_pass ${HUB_UPSTREAM}/v1/channels;
        proxy_http_version 1.1;
        proxy_redirect off;

        # Send the hub nothing of the visitor's: no cookies, no headers, no body.
        proxy_pass_request_headers off;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_set_header Accept "application/json";
        proxy_set_header User-Agent "clanksquare-site (+https://github.com/ZacxDev/clanksquare)";

        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        proxy_connect_timeout 3s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;

        # Upstream headers that could steer nginx or the browser are not honoured.
        proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset Expires Cache-Control Set-Cookie Vary;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header NEL;
        proxy_hide_header Report-To;
        proxy_hide_header Speculation-Rules;
        proxy_hide_header Alt-Svc;
        proxy_hide_header CF-Ray;
        proxy_hide_header CF-Cache-Status;

        proxy_cache hubcache;
        proxy_cache_valid 200 15s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;

        # Forces Content-Type: application/json and caps the body (apiguard.js).
        js_header_filter apiguard.header;
        js_body_filter apiguard.body buffer_type=buffer;
    }

    location /api/ {
        return 404;
    }

    location = / {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        try_files /index.html =404;
    }

    location / {
        return 404;
    }
}
